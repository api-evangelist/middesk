{
  "opencollection": "1.0.0",
  "info": {
    "name": "Middesk subpackage_actions subpackage_timeline API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "subpackage_timeline",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve timeline for a business",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.middesk.com/v1/businesses/:business_id/timeline",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "business_id",
                "value": "",
                "type": "path",
                "description": "Business ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default: 1)"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of events per page (default: 100, max: 100)"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Filter events on or after this date (YYYY-MM-DD format)"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "Filter events on or before this date (YYYY-MM-DD format)"
              },
              {
                "name": "event_types",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of event types to filter by"
              }
            ]
          },
          "docs": "Returns a paginated list of timeline events for a business. Timeline events include Secretary of State (SOS) history events and SOS monitoring events, providing a chronological record of changes to the business's registration data."
        }
      ]
    }
  ],
  "bundled": true
}